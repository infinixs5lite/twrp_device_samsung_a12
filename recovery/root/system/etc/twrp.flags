# mount point	fstype		device			device2				flags
# Logical partitions
system	/system		ext4								flags=display="System";logical;
vendor	/vendor		ext4								flags=display="Vendor";logical;
product	/product	ext4								flags=display="Product";logical;
odm		/odm		ext4								flags=display="ODM";logical;

# Symlinked partitions
/system_image	emmc		/dev/block/dm-0					flags=backup=1;wipeingui;flashimg=1;display="System Image";
/vendor_image	emmc		/dev/block/dm-2					flags=backup=1;wipeingui;flashimg=1;display="Vendor Image";
/product_image	emmc		/dev/block/dm-1					flags=backup=1;wipeingui;flashimg=1;display="Product Image";
/odm_image		emmc		/dev/block/dm-3					flags=backup=1;flashimg=1;wipeingui;display="ODM Image";


# Physical partitions
/metadata	ext4		/dev/block/platform/bootdevice/by-name/md_udc		flags=backup=1;display="Metadata";
/boot		emmc		/dev/block/platform/bootdevice/by-name/boot			flags=backup=1;flashimg=1;display="Boot";
/recovery	emmc		/dev/block/platform/bootdevice/by-name/recovery		flags=backup=1;flashimg=1;display="Recovery";
/vbmeta_samsung 	emmc		/dev/block/platform/bootdevice/by-name/vbmeta_samsung		flags=backup=1;flashimg=1;display="vbmeta_samsung";
/vbmeta_vendor 	emmc		/dev/block/platform/bootdevice/by-name/vbmeta_vendor		flags=backup=1;flashimg=1;display="vbmeta_vendor";
/vbmeta 	emmc		/dev/block/platform/bootdevice/by-name/vbmeta		flags=backup=1;flashimg=1;display="vbmeta";
/efuse 	emmc		/dev/block/platform/bootdevice/by-name/efuse		flags=backup=1;flashimg=1;display="efuse";
/reserved 	emmc		/dev/block/platform/bootdevice/by-name/reserved		flags=backup=1;flashimg=1;display="reserved";
/sec1 	emmc		/dev/block/platform/bootdevice/by-name/sec1		flags=backup=1;flashimg=1;display="sec1";
/prism 	emmc		/dev/block/platform/bootdevice/by-name/prism		flags=backup=1;flashimg=1;display="prism";
/optics 	emmc		/dev/block/platform/bootdevice/by-name/optics		flags=backup=1;flashimg=1;display="optics";
/cache 	emmc		/dev/block/platform/bootdevice/by-name/cache		flags=backup=1;flashimg=1;display="cache";
/omr 	emmc		/dev/block/platform/bootdevice/by-name/omr		flags=backup=1;flashimg=1;display="omr";
/spu 	emmc		/dev/block/platform/bootdevice/by-name/spu		flags=backup=1;flashimg=1;display="spu";
/nvdata 	emmc		/dev/block/platform/bootdevice/by-name/nvdata		flags=backup=1;flashimg=1;display="nvdata";
/nvdata 	emmc		/dev/block/platform/bootdevice/by-name/nvdata		flags=backup=1;flashimg=1;display="nvdata";
/nvdata 	ext4		/dev/block/platform/bootdevice/by-name/nvdata		flags=backup=1;flashimg=1;display="nvdata";
/nvdata 	ext4		/dev/block/platform/bootdevice/by-name/nvdata		flags=backup=1;flashimg=1;display="nvdata";
/sec_efs 	emmc		/dev/block/platform/bootdevice/by-name/sec_efs		flags=backup=1;flashimg=1;display="sec_efs";
/scp1 	emmc		/dev/block/platform/bootdevice/by-name/scp1		flags=backup=1;flashimg=1;display="scp1";
/steady 	emmc		/dev/block/platform/bootdevice/by-name/steady		flags=backup=1;flashimg=1;display="steay";
/tee1 	emmc		/dev/block/platform/bootdevice/by-name/tee1		flags=backup=1;flashimg=1;display="tee1";
/sspm_1 	emmc		/dev/block/platform/bootdevice/by-name/sspm_1		flags=backup=1;flashimg=1;display="sspm_1";
/uh 	emmc		/dev/block/platform/bootdevice/by-name/uh		flags=backup=1;flashimg=1;display="uh";

/data		f2fs		/dev/block/platform/bootdevice/by-name/userdata		flags=wipeingui;length=-16384;
/cache		ext4		/dev/block/platform/bootdevice/by-name/cache		flags=backup=1;display="Cache";
/dtbo		emmc		/dev/block/platform/bootdevice/by-name/dtbo			flags=backup=1;flashimg=1;display="DTBO";
/param		emmc		/dev/block/platform/bootdevice/by-name/param		flags=backup=1;display="Param";
/optics_image	emmc		/dev/block/platform/bootdevice/by-name/optics	flags=backup=1;flashimg=1;display="Optics Image";
/prism_image	emmc		/dev/block/platform/bootdevice/by-name/prism	flags=backup=1;flashimg=1;display="Prism Image";
/gz1		emmc		/dev/block/platform/bootdevice/by-name/gz1
/misc		emmc		/dev/block/platform/bootdevice/by-name/misc			flags=backup=1;flashimg=1;display="Misc";
/efs		emmc		/dev/block/platform/bootdevice/by-name/sec_efs		flags=backup=1;display="EFS";
/modem		emmc		/dev/block/platform/bootdevice/by-name/apnhlos		flags=backup=1;display="Modem";
/mdm		emmc		/dev/block/platform/bootdevice/by-name/modem		flags=backup=1;subpartitionof=/modem;
/dsp		emmc		/dev/block/platform/bootdevice/by-name/dsp
/dtbo		emmc		/dev/block/platform/bootdevice/by-name/dtbo
/md1img		emmc		/dev/block/platform/bootdevice/by-name/md1img
/spmfw		emmc		/dev/block/platform/bootdevice/by-name/spmfw
/scp1		emmc		/dev/block/platform/bootdevice/by-name/scp1
/sspm_1		emmc		/dev/block/platform/bootdevice/by-name/sspm_1		flags=backup=1;flashimg=1;display="sspm_1";	

# USB
/external_sd	auto		/dev/block/mmcblk1p1	/dev/block/mmcblk1		flags=storage;wipeingui;removable;display="External SDcard"
/usb-otg	auto		/dev/block/sdf1		/dev/block/sdf			flags=display="USB-OTG";storage;wipeingui;removable

# Removable storage
/sdcard1            auto       /dev/block/mmcblk1p1   /dev/block/mmcblk1   flags=display="MicroSD";storage;wipeingui;removable;fsflags="utf8"
/usb_otg            auto      /dev/block/sda1        /dev/block/sda        flags=display="USB OTG";storage;wipeingui;removable;fsflags="utf8"

/usbstorage    vfat    /dev/block/sdg1                    /dev/block/sdg         flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable
/external_sd   vfat    /dev/block/mmcblk1p1               /dev/block/mmcblk1     flags=display="MicroSD";storage;wipeingui;removable

# Temporarily generated to workaround Magisk bug on MTK A-only
/nvram		emmc	/dev/block/platform/bootdevice/by-name/nvram			flags=display="NVRAM";backup=1;
/nvcfg		emmc	/dev/block/platform/bootdevice/by-name/nvcfg			flags=display="NVCFG";backup=1;subpartitionof=/nvram;
/nvdata		emmc	/dev/block/platform/bootdevice/by-name/nvdata			flags=display="NVDATA";backup=1;subpartitionof=/nvram;
/persistent	emmc	/dev/block/platform/bootdevice/by-name/persistent		flags=display="PERSISTENT";backup=1;subpartitionof=/nvram;
